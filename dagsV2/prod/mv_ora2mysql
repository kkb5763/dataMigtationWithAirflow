import jaydebeapi
import MySQLdb

from airflow import DAG
from airflow.operators.python import PythonOperator
from datetime import datetime, timedelta
from typing import Any, Dict, Tuple

# ==========================================================
# PROD: Oracle -> MySQL (듀얼 타겟, ~1천만 건, 구간별 태스크)
# ==========================================================
# Oracle MIG -> MySQL hwmig (동일 테이블명, 구간별 태스크)
# STEP_SIZE=1_000_000 → 1천만 건당 태스크 10개 (max_active_tasks 로 병렬)
#
# TABLE_CONFIG 형식은 copy DAG 와 동일 (target + range)
#
# Pool (Admin): prod_oracle_mysql_range / slots=4

ORACLE_CONFIG: Dict[str, Any] = {
    "host": "10.10.5.10",
    "port": 1521,
    "service_name": "ORCL",
    "user": "oracle_user",
    "pass": "oracle_pass",
    "jdbc_jar": "/data/airflow/lib/ojdbc11.jar",
    "driver": "oracle.jdbc.OracleDriver",
}

TGT_MYSQL_TARGETS: Dict[str, Dict[str, Any]] = {
    "mysql_a": {
        "host": "10.10.1.20",
        "port": 3306,
        "user": "root",
        "passwd": "mysql_a_pass",
        "charset": "utf8mb4",
    },
    "mysql_b": {
        "host": "10.10.1.21",
        "port": 3306,
        "user": "root",
        "passwd": "mysql_b_pass",
        "charset": "utf8mb4",
    },
}

MYSQL_DB_MAP: Dict[str, Dict[str, str]] = {
    "MIG": {"mysql_a": "hwmig", "mysql_b": "hwmig"},
}

TABLE_CONFIG: Dict[str, Dict[str, Any]] = {
    "MIG.SAMPLE_TABLE_A": {
        "target": "mysql_a",
        "range": ("ID", 1, 10_000_000),
    },
    "MIG.SAMPLE_TABLE_B": {
        "target": "mysql_b",
        "range": ("ID", 1, 10_000_000),
    },
}

STEP_SIZE = 1_000_000
FETCH_SIZE = 2_000
INSERT_STRATEGY = "REPLACE"


def _sql_literal(v: int) -> str:
    return str(int(v))


def _split_schema_table(full_name: str) -> Tuple[str, str]:
    schema, table = full_name.split(".", 1)
    return schema.upper(), table


def _oracle_jdbc_url(cfg: Dict[str, Any]) -> str:
    host = cfg["host"]
    port = cfg["port"]
    service_name = cfg.get("service_name")
    sid = cfg.get("sid")
    if service_name:
        return f"jdbc:oracle:thin:@//{host}:{port}/{service_name}"
    if sid:
        return f"jdbc:oracle:thin:@{host}:{port}:{sid}"
    raise ValueError("Set ORACLE_CONFIG.service_name or ORACLE_CONFIG.sid")


def _mysql_cfg(schema: str, target_key: str) -> Dict[str, Any]:
    if target_key not in TGT_MYSQL_TARGETS:
        raise ValueError(f"Unknown target: {target_key}. Use one of {list(TGT_MYSQL_TARGETS)}")

    cfg = dict(TGT_MYSQL_TARGETS[target_key])
    schema_map = MYSQL_DB_MAP.get(schema, {})
    if isinstance(schema_map, dict):
        cfg["db"] = schema_map.get(target_key, schema.lower())
    else:
        cfg["db"] = str(schema_map)
    return cfg


def _worker_one_range(
    table: str,
    target_key: str,
    range_col: str,
    range_start: int,
    range_end: int,
    **context: Any,
) -> None:
    schema, tbl = _split_schema_table(table)
    mysql_cfg = _mysql_cfg(schema, target_key)
    print(
        f"[ORACLE-RANGE][{table}][{target_key}] "
        f"range {range_start}~{range_end} -> "
        f"{mysql_cfg['host']}:{mysql_cfg.get('port', 3306)}/{mysql_cfg['db']}",
        flush=True,
    )

    o_conn = None
    m_conn = None
    try:
        m_conn = MySQLdb.connect(**mysql_cfg)
        m_cur = m_conn.cursor()

        o_conn = jaydebeapi.connect(
            ORACLE_CONFIG["driver"],
            _oracle_jdbc_url(ORACLE_CONFIG),
            [ORACLE_CONFIG["user"], ORACLE_CONFIG["pass"]],
            ORACLE_CONFIG["jdbc_jar"],
        )
        o_cur = o_conn.cursor()

        query = (
            f"SELECT * FROM {schema}.{tbl} "
            f"WHERE {range_col} >= {_sql_literal(range_start)} "
            f"AND {range_col} <= {_sql_literal(range_end)}"
        )
        print(f"[ORACLE-RANGE][{table}][{target_key}] query: {query}", flush=True)
        o_cur.execute(query)

        placeholders = ", ".join(["%s"] * len(o_cur.description))
        if INSERT_STRATEGY == "REPLACE":
            insert_sql = f"REPLACE INTO {tbl} VALUES ({placeholders})"
        elif INSERT_STRATEGY == "INSERT":
            insert_sql = f"INSERT INTO {tbl} VALUES ({placeholders})"
        elif INSERT_STRATEGY == "INSERT IGNORE":
            insert_sql = f"INSERT IGNORE INTO {tbl} VALUES ({placeholders})"
        else:
            raise ValueError(f"Unsupported INSERT_STRATEGY: {INSERT_STRATEGY}")

        total = 0
        while True:
            rows = o_cur.fetchmany(FETCH_SIZE)
            if not rows:
                break
            m_cur.executemany(insert_sql, rows)
            m_conn.commit()
            total += len(rows)

        print(
            f"[ORACLE-RANGE][{table}][{target_key}] "
            f"range {range_start}~{range_end} done total={total}",
            flush=True,
        )
    finally:
        if o_conn:
            try:
                o_conn.close()
            except Exception:
                pass
        if m_conn:
            try:
                m_conn.close()
            except Exception:
                pass


with DAG(
    dag_id="prod_oracle_mysql_copy_range_parallel_v1",
    default_args={"owner": "prod", "retries": 1, "retry_delay": timedelta(minutes=5)},
    start_date=datetime(2026, 4, 1),
    schedule_interval=None,
    catchup=False,
    tags=["prod", "oracle", "mysql", "copy", "range", "parallel", "large"],
    max_active_tasks=4,
) as dag:
    for table_name, conf in TABLE_CONFIG.items():
        target_key = conf["target"]
        range_col, start, end = conf["range"]
        safe_name = table_name.replace(".", "_")
        current = int(start)
        end_i = int(end)
        while current <= end_i:
            current_end = min(current + STEP_SIZE - 1, end_i)
            PythonOperator(
                task_id=f"migrate_{safe_name}_{target_key}_{current}_{current_end}",
                python_callable=_worker_one_range,
                pool="prod_oracle_mysql_range",
                pool_slots=1,
                op_kwargs={
                    "table": table_name,
                    "target_key": target_key,
                    "range_col": range_col,
                    "range_start": current,
                    "range_end": current_end,
                },
            )
            current += STEP_SIZE
